    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../MyWork/src/MyWork.App/MyWork.App.csproj" />
    <ProjectReference Include="../../../MyWork/src/MyWork.Core/MyWork.Core.csproj" />
    <ProjectReference Include="../../../MyWork/src/MyWork.Common/MyWork.Common.csproj" />
  </ItemGroup>
</Project>
